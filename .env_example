# Core app settings
HOST=0.0.0.0
PORT=8080

# Database
DATABASE_URL=postgres://postgres:budgetpass@db:5432/postgres?sslmode=disable
DB_CONNECT_RETRIES=10
DB_CONNECT_INTERVAL_MS=500

# Auth (generate a strong secret: e.g., `openssl rand -hex 32`)
JWT_SECRET=change-me
API_TOKEN=

# Passkeys (WebAuthn)
RELYING_PARTY_ID=localhost
RELYING_PARTY_NAME=My Personal Budget

# OAuth authorization server (lets web clients such as the Claude app connect to
# /mcp without a pasted API key). PUBLIC_BASE_URL is the origin remote clients
# reach this server on; it is what the OAuth metadata advertises as the issuer,
# so it must be exact and cannot be inferred from a request. Leave it empty to
# disable OAuth -- API keys keep working either way.
PUBLIC_BASE_URL=
OAUTH_ACCESS_TOKEN_TTL_MS=3600000
OAUTH_AUTH_CODE_TTL_MS=300000

# Client registration has to be open -- a remote MCP client cannot be
# pre-provisioned -- so these bound what an unauthenticated caller leaves behind.
# The limit is global, not per-address: this server sits behind a proxy, so
# X-Forwarded-For is the only thing distinguishing callers and a caller can set
# it freely. OAUTH_STALE_AFTER_MS must comfortably exceed the time between
# registering and consenting.
OAUTH_REGISTRATION_LIMIT=20
OAUTH_REGISTRATION_WINDOW_MS=3600000
OAUTH_SWEEP_INTERVAL_MS=3600000
OAUTH_STALE_AFTER_MS=86400000

# CORS. The OAuth discovery documents and /mcp answer any origin regardless of
# this setting: they carry no cookie-borne authority, and a remote client's
# origin is not knowable in advance.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Static assets
STATIC_DIR=/app/static
